# Optional: without an LLM key extraction falls back to OCR heuristics
MISTRAL_API_KEY=
# Sign verification reports (use a long random value, e.g. `openssl rand -hex 32`)
REPORT_SECRET=

# Optional
ALLOWED_ORIGINS=http://localhost:3000
API_KEYS=                     # comma-separated; if set, /verify* require an X-API-Key header
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_VERIFICATIONS=3
PROOF_RETENTION_HOURS=24
TRUFOR_MODEL_PATH=            # official TruFor checkpoint; without it forensics runs ELA only

# Optional: chat model for extraction (default mistral-small-latest)
MISTRAL_MODEL=

# Extraction LLM: groq (default) | huggingface | mistral
EXTRACTION_PROVIDER=groq
GROQ_API_KEY=
# HF_TOKEN=   (if EXTRACTION_PROVIDER=huggingface)

# OCR ensemble (engines run in parallel and vote): tesseract, paddle, easyocr, mistral (cloud, opt-in)
OCR_ENGINES=tesseract,paddle,easyocr
OCR_ENGINE_TIMEOUT=60
OCR_WARMUP=true                 # load OCR models at startup

# Supabase: Google sign-in + per-user report history (cafs_reports)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=      # secret; lets the backend write reports. Never expose to the browser.
